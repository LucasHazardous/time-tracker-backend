{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "outDir": "./dist",
      "rootDir": "./src",
      "strict": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": true,
      "removeComments": true,
      "declaration": true,
      "sourceMap": true,
    },
    "include": [
      "./src/**/*.ts",
    ],
    "exclude": [
      "./node_modules"
    ]
  }
  